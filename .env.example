# PushBack configuration — copy to .env and fill in your keys.
# All values are optional; without keys the app runs in demo mode.

# --- Voice: Cartesia Managed Agent (Ink STT + Cartesia-hosted LLM + Sonic TTS) ---
# Get a key at https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Optional overrides:
# CARTESIA_AGENT_MODEL=gpt-5.4-mini           # any id from GET /v1/agents/models (e.g. claude-sonnet-4.6)
# CARTESIA_VOICE_INTERVIEWER=<voice id>       # also _INVESTOR, _COWORKER, _BOSS (default: auto-picked)
# CARTESIA_AGENT_ID_INTERVIEWER=<agent id>    # use an agent you configured in the Cartesia Playground
# VOICE_PROVIDER=demo                         # force the browser-speech demo voice

# --- Reports + "Better phrasing": any OpenAI-compatible chat-completions LLM ---
# Without a key (or if the call fails) the local heuristic analyzer is used.
# Examples:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4.1
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1   LLM_MODEL=claude-sonnet-4-5
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openai/gpt-4.1
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1
# (Legacy shorthand still accepted: OPENAI_API_KEY / OPENAI_EVAL_MODEL)

# --- HeyGen (video avatar — not yet integrated) ---
# Get a key at https://app.heygen.com/settings (API keys)
HEYGEN_API_KEY=

# --- Server ---
PORT=3000

# MeetSim configuration — copy to .env and fill in your keys.
# All values are optional; without keys the app runs in demo mode.

# --- OpenAI (realtime voice + LLM evaluation) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional overrides (defaults shown):
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_EVAL_MODEL=gpt-4.1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- HeyGen (video avatar — not yet integrated) ---
# Get a key at https://app.heygen.com/settings (API keys)
HEYGEN_API_KEY=

# --- Server ---
PORT=3000
